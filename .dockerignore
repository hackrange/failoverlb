# Keep the build context small and keep secrets out of the image.
#
# Anything COPY'd into an image stays in that layer even if a later step
# deletes it, so a stray .env would ship to anyone who pulls the image.

# ==============================================================================
# Secrets.  These must never land in an image layer.
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
secrets/
certs/
ca/
*.join-token
join-token*

# ==============================================================================
# Runtime data.  Lives in a volume, not in the image.
# ==============================================================================
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
generated/
staging/
backups/
logs/
*.log
*.tar.gz

# ==============================================================================
# Version control and CI
# ==============================================================================
.git/
.gitignore
.github/
.gitlab-ci.yml

# ==============================================================================
# Python leftovers.  The image installs from requirements.txt; a host
# virtualenv is dead weight and may be the wrong architecture.
# ==============================================================================
__pycache__/
*.py[cod]
*.so
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.egg-info/
build/
dist/

# ==============================================================================
# Stuff that does not belong in the container
# ==============================================================================

# The host agent runs on the host, outside the container, on purpose.
host-agent/

# Docs and the installer are for people, not for the runtime.
docs/
README.md
CHANGELOG.md
LICENSE
install.sh

# Compose files describe how to run the image.  The image does not need them.
docker-compose*.yml
Dockerfile
.dockerignore

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
