# The host agent for Failover LB.
#
# The only piece running as root.  The container talks to it over a unix
# socket and it only runs the verbs on its list.  It needs root to write
# /etc/nginx and reload nginx; the settings below limit what else root can do.

[Unit]
Description=Failover LB host agent
Documentation=file:///opt/nginx-fleet-manager/README.md
After=network.target
# Not Requires=: if a bad config took nginx down, the agent is what you need
# running to roll it back.
Wants=nginx.service

# Five crashes in a minute and it stays stopped.  These belong in [Unit];
# systemd silently ignores them in [Service].
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/nginx-fleet-manager/nginx-mgr-agent.py
Restart=always
RestartSec=5s

Environment=NFM_AGENT_LOG_LEVEL=INFO
Environment=NFM_AGENT_GROUP=nginxmgr
Environment=NFM_NGINX_PREFIX=/etc/nginx
Environment=NFM_NGINX_BIN=/usr/sbin/nginx
Environment=NFM_ACME_WEBROOT=/var/www/certbot
Environment=PYTHONUNBUFFERED=1

# systemd makes the socket folder for us.
RuntimeDirectory=nginxmgr
RuntimeDirectoryMode=0750

# Required.  The container bind mounts /run/nginxmgr, and a bind mount
# follows the directory, not the name.  If systemd recreated it on restart,
# the container would be left holding a deleted directory and would never see
# the new socket until it was recreated.
RuntimeDirectoryPreserve=yes

# ---- locking it down --------------------------------------------------------
#
# Everything below narrows what root can reach.

# Off because children inherit it, and public_ip (curl, dig) and certbot
# need the network.  Turn it on if you never call public_ip and handle
# certificates elsewhere.
# PrivateNetwork=yes

NoNewPrivileges=yes

PrivateTmp=yes

# Read only filesystem except the paths listed.  A leading dash skips a
# missing path; without it systemd fails the unit with 226/NAMESPACE and no
# hint which path.  The letsencrypt dirs only exist after certbot's first run.
# Paths the agent cannot work without are left undashed so they fail loudly.
ProtectSystem=strict
ReadWritePaths=/etc/nginx
ReadWritePaths=-/etc/letsencrypt
ReadWritePaths=-/var/log/letsencrypt
ReadWritePaths=-/var/lib/letsencrypt
ReadWritePaths=/var/www/certbot
ReadWritePaths=/var/backups/nginx-fleet-manager
ReadWritePaths=/usr/local/lib/nginx-fleet-manager
ReadWritePaths=/run/nginxmgr
ReadWritePaths=/run

# Tunnel config and key.  Dashed so a box without wireguard still starts;
# the tunnel verbs report it as unavailable.
ReadWritePaths=-/etc/wireguard

# nginx runs as our child for tests and reloads, so it inherits this sandbox.
# A missing path makes "nginx -t" fail with a read only filesystem error that
# looks like a bad config.  These match the build flags in nginx-installer.sh
# (pid and lock files are covered by /run).  Add yours if you build with
# different paths.
ReadWritePaths=-/var/log/nginx
ReadWritePaths=-/var/cache/nginx

# GeoIP country database.  Dashed so a box without it still starts; the
# install verb reports the folder as not writable instead.
ReadWritePaths=-/usr/share/GeoIP

ProtectHome=yes

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

# AF_NETLINK is for nft, which installs the port 53 redirect to the
# manager's DNS listener.  Without it nft fails with "Unable to initialize
# Netlink socket".
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Off because CPython and some extension modules map writable memory as
# executable, and the service dies with signal=SYS.  Enable only after testing
# a restart with your exact Python build.
# MemoryDenyWriteExecute=yes

# Syscall filtering is off on purpose.  On a fresh Ubuntu 24.04 box every
# attempt killed the agent with SIGSYS, and systemd does not say which
# syscall was refused.  The filesystem, capability and verb limits are what
# contain this process; seccomp would only be an extra layer.
#
# To try it, test what your Python needs first:
#
#   sudo systemd-run --pty --property=SystemCallFilter=@system-service \
#        /usr/bin/python3 /opt/nginx-fleet-manager/nginx-mgr-agent.py
#
# then add it in a drop-in so upgrades do not overwrite it:
#
#   /etc/systemd/system/nginx-mgr-agent.service.d/seccomp.conf
#
# SystemCallFilter=@system-service
# SystemCallFilter=~@privileged @obsolete @cpu-emulation @mount @swap
SystemCallArchitectures=native

# Only the capabilities in use:
#   CHOWN, DAC_OVERRIDE, FOWNER: write config and set ownership
#   SETUID, SETGID: certbot drops privileges for its hooks
#   KILL: signal nginx to reload when there is no systemd
#   NET_BIND_SERVICE: nginx -t binds the real listen ports, and inherits
#     this list; without it tests fail with "bind() ... (13: Permission
#     denied)", which looks like an nginx problem.
#   NET_ADMIN: the firewall rule redirecting port 53 to the unprivileged
#     DNS listener.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL CAP_NET_BIND_SERVICE CAP_NET_ADMIN

# Keep one bad apply from eating the box.
LimitNOFILE=4096
TasksMax=64
MemoryMax=512M

# Logs go to the journal and to syslog.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nfm-agent

[Install]
WantedBy=multi-user.target
