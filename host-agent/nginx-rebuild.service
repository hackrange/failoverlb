[Unit]
Description=Rebuild nginx from source for the fleet manager
Documentation=file:///opt/nginx-installer.sh

# A source build installs compilers, builds luajit into /usr/local, compiles
# nginx, replaces /usr/sbin/nginx and keeps a rollback copy in /var/backups.
# The agent runs under ProtectSystem=strict with a short list of writable
# paths, and widening that for one verb would weaken it for all the others.
#
# So the build runs here, deliberately unsandboxed, as a static unit you can
# read before installing rather than something the agent builds at run time.

[Service]
Type=oneshot

# Versions to build, the only input.  The agent validates each value before
# writing it.  Lives on tmpfs, so it does not survive a reboot.
EnvironmentFile=/run/nginxmgr/rebuild.env

ExecStart=/opt/nginx-installer.sh install

# Record the outcome for the agent.  A finished oneshot unit that nothing
# references gets unloaded and its result properties read as zero, so a
# successful build looks like one that never ran.  This file existing means
# the build is over; the agent deletes it before starting another.
ExecStopPost=/bin/sh -c 'echo "${SERVICE_RESULT} ${EXIT_STATUS}" > /run/nginxmgr/rebuild.result'

# Both streams to one file, since failures land on stderr.  The agent tails
# this so the GUI can show progress.
StandardOutput=append:/var/log/nginx-fleet-manager-upgrade.log
StandardError=append:/var/log/nginx-fleet-manager-upgrade.log

# A build takes 10 to 20 minutes.  An hour covers a slow box without letting
# a wedged build hold the fleet walk open forever.
TimeoutStartSec=3600

# The agent polls whether this is still active, so it must not stay active
# after exit.
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
