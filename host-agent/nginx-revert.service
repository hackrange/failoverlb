[Unit]
Description=Put the previous nginx build back
Documentation=file:///opt/nginx-installer.sh

# The other half of nginx-rebuild.service, unconfined for the same reason.
# A revert copies a binary over /usr/sbin/nginx, which the agent's sandbox
# blocks.  A half-done revert (old binary, new perl module) leaves nginx
# unable to start.
#
# A separate unit rather than a parameter, so each ExecStart is fixed.

[Service]
Type=oneshot
ExecStart=/opt/nginx-installer.sh revert

StandardOutput=append:/var/log/nginx-fleet-manager-upgrade.log
StandardError=append:/var/log/nginx-fleet-manager-upgrade.log

# A file copy and a restart.  Five minutes is plenty.
TimeoutStartSec=300
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
