# Install what the tunnel needs on this box, on request from the GUI.
#
# Same reason as nginx-rebuild.service: the agent runs under
# ProtectSystem=strict and its children inherit that, so it cannot run a
# package manager.  This unit is unsandboxed and runs one script that installs
# wireguard-tools, plus wireguard-go if the kernel lacks wireguard.

[Unit]
Description=Install tunnel support for the fleet manager
Documentation=file:///opt/nfm-tunnel-installer.sh

[Service]
Type=oneshot

ExecStart=/opt/nfm-tunnel-installer.sh install

# Record the outcome for the agent.  A finished oneshot unit gets unloaded
# and its result properties read as zero, so systemd can't tell us afterward.
# This file existing means the install is over; the agent deletes it first.
ExecStopPost=/bin/sh -c 'echo "${SERVICE_RESULT} ${EXIT_STATUS}" > /run/nginxmgr/tunnel-install.result'

# Both streams to one file; the useful errors (apt, /dev/net/tun) are on
# stderr.
StandardOutput=append:/var/log/nginx-fleet-manager-tunnel-install.log
StandardError=append:/var/log/nginx-fleet-manager-tunnel-install.log

# Two small packages.  Enough for a slow mirror without letting a wedged apt
# hold the page open.
TimeoutStartSec=600

# The agent polls whether this is still active, so it must not stay active
# after exit.
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
